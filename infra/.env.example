# Copy this file to .env and fill in real values. Never commit .env.
N8N_ENCRYPTION_KEY=changeme_generate_a_real_random_32char_string
N8N_HOST=localhost

# Wired up as n8n credentials, not read directly by n8n from this file - set here as a
# reference for which real values you need before importing the workflow JSON. Qdrant runs
# unauthenticated on localhost in this setup, so it needs no key here.
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
