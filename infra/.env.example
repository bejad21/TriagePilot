# Copy this file to .env and fill in the values. Never commit .env.
N8N_ENCRYPTION_KEY=changeme_generate_a_real_random_32char_string
N8N_HOST=localhost

# n8n reads these as credentials, not from this file; they are listed here so you know which
# values to prepare before importing the workflows. Qdrant runs unauthenticated on localhost
# and needs no key.
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
