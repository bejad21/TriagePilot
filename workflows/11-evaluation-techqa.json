    {
      "id": "e1a1a1a1-0007-4a11-9a11-000000000007",
      "name": "Generate Reverse Questions",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        280,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are evaluating answer relevancy using the RAGAS methodology: given an answer, generate questions that this answer would be a good, complete response to (reverse-engineering the question from the answer).\n\nSystem's actual answer:\n{{ $('Combine Retrieved Context').item.json.actual_answer }}\n\nGenerate exactly 3 different questions that this answer directly and completely responds to. If the answer is noncommittal, vague, or a refusal/escalation with no real informational content (e.g. \"this has been routed to a human for review\"), return an empty list instead - a noncommittal answer cannot be reverse-engineered into a real question.\n\nReturn ONLY JSON: {\"questions\": [\"<question 1>\", \"<question 2>\", \"<question 3>\"]} or {\"questions\": []} for noncommittal answers.",
        "hasOutputParser": true,
        "messages": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
