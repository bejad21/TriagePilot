      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const chunks = $input.all()\n  .map(item => item.json.document && item.json.document.pageContent)\n  .filter(Boolean);\nconst source = $('Extract Result').first().json;\nconst first = $input.first();\nreturn [{\n  json: {\n    question: source.question,\n    expected_answer: source.expected_answer,\n    actual_answer: source.actual_answer,\n    status: source.status,\n    retrieved_context: chunks.join('\\n\\n---\\n\\n'),\n    retrieved_chunks: chunks,\n    hit_at_k: first ? first.json.hit_at_k : false,\n    reciprocal_rank: first ? first.json.reciprocal_rank : 0,\n  }\n}];"
      }
    },
    {
      "id": "e1a1a1a1-0004-4a11-9a11-000000000004",
      "name": "Answer Correctness Judge",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        40,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Ground truth (answer grounded in a real IBM Technote, for a real question asked on IBM's developer support forums):\n{{ $json.expected_answer }}\n\nSystem's actual answer:\n{{ $json.actual_answer }}\n\nRate how consistent the actual answer is with this specific ground truth resolution on a scale of 1 (contradicts or unrelated) to 5 (fully consistent, no unsupported claims). Note: the ground truth is one real person's resolution and may reference environment-specific details (a config value, a PR, an external link) the system cannot be expected to reproduce verbatim - score based on substantive consistency with the underlying fix, not exact wording. Return ONLY JSON: {\"score\": <1-5 integer>}.",
        "hasOutputParser": true,
        "messages": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
