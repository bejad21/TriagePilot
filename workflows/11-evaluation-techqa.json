    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function sanitize(name) {\n  return (name || \"\").replace(/[^a-zA-Z0-9._-]+/g, \"-\").replace(/^-+|-+$/g, \"\");\n}\n\nconst expectedSource = sanitize($('Evaluation Trigger').first().json.source_url);\nconst retrieved = $input.all().map(i => i.json);\n\nlet hitAtK = false;\nlet reciprocalRank = 0;\nfor (let rank = 0; rank < retrieved.length; rank++) {\n  const meta = retrieved[rank].document && retrieved[rank].document.metadata;\n  const chunkSource = sanitize(meta && meta.source);\n  if (expectedSource && chunkSource === expectedSource) {\n    hitAtK = true;\n    reciprocalRank = 1 / (rank + 1);\n    break;\n  }\n}\n\nreturn $input.all().map(item => ({\n  json: {\n    ...item.json,\n    hit_at_k: hitAtK,\n    reciprocal_rank: reciprocalRank,\n  },\n}));"
      },
      "id": "compute-retrieval-metrics-node",
      "name": "Compute Retrieval Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        0
      ]
    },
    {
      "id": "ragas-ctx-precision-judge",
      "name": "Context Precision Judge",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        60,
        -180
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are evaluating context precision using the RAGAS methodology: for each retrieved chunk below (numbered, in retrieval rank order), judge whether it is relevant to answering the question - i.e. whether it would help produce the reference answer.\n\nQuestion:\n{{ $('Combine Retrieved Context').item.json.question }}\n\nReference answer (ground truth):\n{{ $('Combine Retrieved Context').item.json.expected_answer }}\n\nRetrieved chunks, in rank order (chunk 1 is the top-ranked result):\n{{ $('Combine Retrieved Context').item.json.retrieved_chunks.map((c, i) => `Chunk ${i+1}:\\n${c}`).join('\\n\\n---\\n\\n') }}\n\nReturn ONLY JSON: {\"relevance\": [true|false, true|false, ...]} - exactly one boolean per chunk, in the same order as listed above.",
        "hasOutputParser": true,
        "messages": {}
      }
    },
    {
      "id": "ragas-ctx-precision-parser",
      "name": "Context Precision Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        60,
        -60
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"relevance\": {\"type\": \"array\", \"items\": {\"type\": \"boolean\"}}}, \"required\": [\"relevance\"]}",
        "autoFix": false
      }
    },
    {
      "id": "ragas-ctx-precision-model",
      "name": "Context Precision Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatMistralCloud",
      "typeVersion": 1,
      "position": [
        60,
        -300
      ],
      "parameters": {
        "model": "mistral-small-latest"
      },
      "credentials": {
        "mistralCloudApi": {
          "id": "wtnPQWEjBytZDQH9",
          "name": "Mistral account"
        }
      }
    },
    {
      "id": "ragas-compute-ctx-precision",
      "name": "Compute Context Precision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const relevance = ($json.output && $json.output.relevance) || [];\nlet numRelevant = 0;\nlet sumPrecisionAtK = 0;\nfor (let k = 0; k < relevance.length; k++) {\n  if (relevance[k]) {\n    numRelevant++;\n    sumPrecisionAtK += numRelevant / (k + 1);\n  }\n}\nconst score = numRelevant > 0 ? sumPrecisionAtK / numRelevant : 0;\nconst source = $('Combine Retrieved Context').first().json;\nreturn { json: { ...source, context_precision_score: score } };"
      }
    },
    {
      "id": "ragas-ctx-recall-judge",
      "name": "Context Recall Judge",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        580,
        -180
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are evaluating context recall using the RAGAS methodology: decompose the REFERENCE answer (ground truth) into distinct atomic factual claims, then judge whether each claim can be attributed to (is supported by) the retrieved context.\n\nReference answer (ground truth):\n{{ $('Combine Retrieved Context').item.json.expected_answer }}\n\nRetrieved context:\n{{ $('Combine Retrieved Context').item.json.retrieved_context }}\n\nSteps:\n1. Break the reference answer into a list of distinct, atomic factual claims.\n2. For each claim, judge: is it attributable to / supported by the retrieved context above (true), or not present in the retrieved context (false)?\n\nReturn ONLY JSON: {\"claims\": [{\"claim\": \"<claim text>\", \"attributed\": true|false}, ...]}.",
        "hasOutputParser": true,
        "messages": {}
      }
    },
    {
      "id": "ragas-ctx-recall-parser",
      "name": "Context Recall Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        580,
        -60
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"claims\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"claim\": {\"type\": \"string\"}, \"attributed\": {\"type\": \"boolean\"}}, \"required\": [\"claim\", \"attributed\"]}}}, \"required\": [\"claims\"]}",
        "autoFix": false
      }
    },
    {
      "id": "ragas-ctx-recall-model",
      "name": "Context Recall Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatMistralCloud",
      "typeVersion": 1,
      "position": [
        580,
        -300
      ],
      "parameters": {
        "model": "mistral-small-latest"
      },
      "credentials": {
        "mistralCloudApi": {
          "id": "wtnPQWEjBytZDQH9",
          "name": "Mistral account"
        }
      }
    },
    {
      "id": "ragas-compute-ctx-recall",
      "name": "Compute Context Recall",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        -180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claims = ($json.output && $json.output.claims) || [];\nconst total = claims.length;\nconst attributed = claims.filter(c => c.attributed).length;\nconst score = total > 0 ? attributed / total : null;\nconst source = $('Combine Retrieved Context').first().json;\nreturn { json: { ...source, context_recall_score: score } };"
      }
    },
    {
      "id": "ragas-compute-faithfulness",
      "name": "Compute Faithfulness Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claims = ($json.output && $json.output.claims) || [];\nconst total = claims.length;\nconst supported = claims.filter(c => c.supported).length;\nconst score = total > 0 ? supported / total : null;\nreturn { json: { ...$json, faithfulness_score: score, faithfulness_claim_count: total, faithfulness_supported_count: supported } };"
      }
    },
    {
      "id": "ragas-embed-questions",
      "name": "Embed Questions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.mistral.ai/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mistralCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"mistral-embed\", input: [ $('Combine Retrieved Context').item.json.question, ...($json.output.questions || []) ] }) }}",
        "options": {}
      },
      "credentials": {
        "mistralCloudApi": {
          "id": "wtnPQWEjBytZDQH9",
          "name": "Mistral account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "ragas-compute-relevancy",
      "name": "Compute Answer Relevancy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function cosineSim(a, b) {\n  let dot = 0, na = 0, nb = 0;\n  for (let i = 0; i < a.length; i++) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }\n  const denom = Math.sqrt(na) * Math.sqrt(nb);\n  return denom > 0 ? dot / denom : 0;\n}\nconst data = ($json.data || []).map(d => d.embedding);\nif (data.length < 2) {\n  return { json: { ...$json, answer_relevancy_score: 0 } };\n}\nconst originalQ = data[0];\nconst generated = data.slice(1);\nconst sims = generated.map(e => cosineSim(originalQ, e));\nconst avg = sims.reduce((a, b) => a + b, 0) / sims.length;\nreturn { json: { ...$json, answer_relevancy_score: avg } };"
      }
    }
  ],
